# Copy to contracts/.env and fill in your own values. contracts/.env is
# gitignored (see root .gitignore's `.env` rule) — never commit real secrets.

# Deployer wallet private key (0x-prefixed). Needs testnet ETH on whichever
# network you're deploying to (Sepolia / Base Sepolia / zkSync Era Sepolia).
PRIVATE_KEY=

# RPC endpoint for the network you're deploying to right now.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ZKSYNC_SEPOLIA_RPC_URL=

# Optional: contract verification on the network's block explorer.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
