# Frontend environment template — copy to .env.local for local dev,
# and set the same vars in your Vercel project for production.
# NOTE: .env.local is gitignored. Never commit real API keys.

# Network
NEXT_PUBLIC_DEFAULT_NETWORK=sepolia
NEXT_PUBLIC_CHAIN_ID=11155111

# RPC URLs — optional. If unset, the app falls back to public endpoints
# (see frontend/src/config/contracts.ts). Use your own key for reliability.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=

# Self Protocol
NEXT_PUBLIC_SELF_HUB_ADDRESS=0x16ECBA51e18a4a7e61fdC417f0d47AFEeDfbed74
NEXT_PUBLIC_SELF_VERIFICATION_METHOD=passport

# App
NEXT_PUBLIC_APP_NAME=ZK-AfterLife
NEXT_PUBLIC_APP_DESCRIPTION=Private Digital Inheritance System
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
